# Environment Configuration

# Application
ENVIRONMENT=development
DEBUG=True

# Database Configuration
# Options: sqlite, mysql, postgresql
DB_TYPE=sqlite
SQLITE_DB_PATH=cricbuzz_data.db

# MySQL Configuration (if using MySQL)
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=cricbuzz_db
MYSQL_PORT=3306

# PostgreSQL Configuration (if using PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=cricbuzz_db
POSTGRES_PORT=5432

# Cricbuzz API Configuration
# Get your API key from: https://www.cricapi.com/
CRICBUZZ_API_KEY=YOUR_API_KEY_HERE

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
